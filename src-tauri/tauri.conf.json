{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopAssistant",
  "version": "0.0.0",
  "identifier": "local.desktopassistant.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DesktopAssistant",
        "width": 200,
        "height": 200,
        "x": 400,
        "y": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
